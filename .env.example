# Model routing (which upstream models to use, their endpoint URLs, and API
# keys) is configured in router.yaml, not here. Copy router.yaml.example to
# router.yaml and fill it in -- the server refuses to start without it.
#
# router.yaml supports ${ENV_VAR} / ${ENV_VAR:-default} interpolation, so you
# can still keep secrets in this .env file and reference them from a
# router.yaml entry, e.g.:
#   providerApiKey: ${OPENAI_API_KEY}
#
# Uncomment and fill in whichever keys your router.yaml entries reference:

# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# GEMINI_API_KEY="your-google-ai-studio-key"

# Optional: extra headers forwarded on every upstream request. See README.
# CUSTOM_HEADER_ORIGINATOR="my-client"
