{
  "name": "claude-proxy-node",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node/Fastify port of server.py: an Anthropic Messages API proxy that routes to OpenAI-compatible, Gemini, and Anthropic-compatible backends via router.yaml.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "gpt-tokenizer": "^2.6.2",
    "js-yaml": "^4.1.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
