# router.yaml
#
# Centralized model routing configuration. Copy this file to router.yaml
# (git-ignored) and fill in your own models/keys. The server refuses to start
# if router.yaml is missing or invalid.
#
# ${ENV_VAR} and ${ENV_VAR:-default_value} are interpolated from the process
# environment (e.g. from .env) at load time, so secrets never need to be
# committed here.

# Required. The id of the default model to use for any tier that has no
# tier-specific override below. Must match the `id` of an entry in `models`.
preferredModel: minimax/minimax-m3

# Optional per-tier overrides. Each falls back to `preferredModel` if unset.
# preferredModelHaiku: openai/gpt-4.1-mini
# preferredModelSonnet: minimax/minimax-m3
# preferredModelOpus: anthropic/claude-opus-4-20250514

models:
  # LiteLLM canonical id (`id`) is what preferredModel/preferredModelHaiku/etc.
  # reference. `providerModelName` is the exact string sent to the upstream
  # API -- these can differ when a gateway uses a non-standard model name.
  - id: minimax/minimax-m3
    providerModelName: minimaxai/minimax-m3
    endpointType: openai # openai | anthropic | gemini
    providerBaseUrl: https://api.example.com/v1 # empty/omitted = provider default
    providerApiKey: ${MINIMAX_API_KEY}
    displayName: "MiniMax M3"

  - id: openai/gpt-4.1
    providerModelName: gpt-4.1
    endpointType: openai
    providerApiKey: ${OPENAI_API_KEY}
    # Optional. `thinking` requests from the client are forwarded upstream as
    # `reasoning_effort` by default, since most OpenAI-compatible gateway
    # models (glm, minimax, nemotron, ...) are reasoning-capable even though
    # their name doesn't match the server's built-in reasoning-model pattern
    # (o1-o4/gpt-5/deepseek-r/qwq/grok-reasoning). Set true here for a
    # non-reasoning model that should just ignore thinking requests.
    disable_reasoning: true

  - id: gemini-2.5-pro
    providerModelName: gemini-2.5-pro
    endpointType: gemini
    providerApiKey: ${GEMINI_API_KEY}

  - id: anthropic/claude-opus-4-20250514
    providerModelName: claude-opus-4-20250514
    endpointType: anthropic
    providerApiKey: ${ANTHROPIC_API_KEY}
    # Optional. Claude Code's `/effort` slash command sends one of
    # low/medium/high/xhigh/max in the request; by default the proxy passes
    # that value through unchanged (as `reasoning_effort` for OpenAI-style
    # models, or `output_config.effort` for real Anthropic models). Use
    # `reasoning_effort_map` to remap levels this specific model/gateway
    # doesn't accept. Only listed keys are remapped; anything else (and
    # anything omitted from the map) still passes through as-is.
    #
    # This matters for real Anthropic models in particular: older litellm
    # versions reject `output_config.effort: "xhigh"` outright, and reject
    # "max" for any model that doesn't match litellm's internal
    # claude-opus-4-6-ish naming pattern -- which most current model ids
    # (including this example's claude-opus-4-20250514) don't. Remap those
    # down to something your installed litellm version accepts:
    reasoning_effort_map:
      xhigh: high
      max: high
